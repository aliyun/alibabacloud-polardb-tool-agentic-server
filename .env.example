# PolarDB Agentic Server - environment variables
# Copy this file to .env and fill in actual values: cp .env.example .env
# .env is listed in .gitignore and must not be committed.

# Required
# Initial administrator password for builtin auth mode. Used to create the admin user on first startup.
PAS_ADMIN_INITIAL_PASSWORD=changeme

# AES-256-GCM encryption key. Base64 encoded, at least 32 bytes.
# Generate with: python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
PAS_ENCRYPTION_KEY=

# Server
# PAS_SERVER_HOST=0.0.0.0
# PAS_SERVER_PORT=18760
# PAS_SERVER_LOG_LEVEL=info
PAS_SERVER_DEV_MODE=true

# Authentication
PAS_AUTH_MODE=builtin

# Database
PAS_DATABASE_URL=sqlite+aiosqlite:///data/polardb_agentic.db

# Alibaba Cloud. Required when using the PolarDB OpenAPI integration.
# PAS_ALIYUN_ACCESS_KEY_ID=
# PAS_ALIYUN_ACCESS_KEY_SECRET=
# PAS_ALIYUN_REGION_ID=cn-hangzhou
