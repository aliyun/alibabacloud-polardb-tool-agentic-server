# The service has exactly two bootstrap settings. All other configuration is
# completed after startup through the guided UI or `pas config`.
PAS_DATABASE_URL=mysql+aiomysql://user:password@metadata-db:3306/pas

# Base64-encoded 32-byte root key, or file:/absolute/path to a mode-0600 file.
# Back this value up independently; losing it makes encrypted configuration
# and shared signing keys unrecoverable.
PAS_ENCRYPTION_KEY=
